{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "standard": {
      "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s"
    },
    "detailed": {
      "format": "%(asctime)s [%(levelname)s] %(name)s:%(lineno)d: %(message)s"
    }
  },
  "handlers": {
    "default": {
      "level": "INFO",
      "formatter": "standard",
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "logs/forex_bot.log",
      "maxBytes": 10485760,
      "backupCount": 5
    },
    "error": {
      "level": "ERROR",
      "formatter": "detailed",
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "logs/errors.log",
      "maxBytes": 10485760,
      "backupCount": 10
    }
  },
  "loggers": {
    "": {
      "handlers": [
        "default"
      ],
      "level": "INFO",
      "propagate": false
    },
    "src": {
      "handlers": [
        "default",
        "error"
      ],
      "level": "INFO",
      "propagate": false
    }
  }
}