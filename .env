# ============================================================================
# NEWS API CONFIGURATION (ISSUE #4 FIX: DISABLE MOCK MODE - ENABLE LIVE PROVIDER)
# ============================================================================
# ISSUE #4 RESOLVED: Using NewsAPI.org for live fundamental analysis
# API Key obtained from: https://newsapi.org/
# Free plan: 100 requests/day (sufficient for hourly checks with cache)
# Standard plan: 500/day (recommended for 1m-5m candle strategies)

# ✅ LIVE NEWS API KEY (Active)
NEWS_API_KEY=64b3b223955b40a4a6fc790f7b928719

# ✅ DISABLE MOCK MODE - Enable live news provider
NEWS_PROVIDER=newsapi        # ===== ISSUE #4: Must be "newsapi" (not "mock" or unset) =====
NEWS_MOCK_MODE=false         # ===== ISSUE #4: Must be false to enable live data =====
NEWS_ENABLED=true            # Enable news collection
NEWS_REQUIRE_LIVE=false      # Don't block trades if news briefly unavailable

# ============================================================================
# OLLAMA LLM CONFIGURATION (ISSUE #1 FIX: COLD START TIMEOUT)
# ============================================================================
# ISSUE #1 RESOLVED: Added keep_alive parameter and increased timeouts for cold starts
# - keep_alive: "1h" keeps model loaded in VRAM, preventing 8-10s reload penalty
# - Timeouts: 15s (fast) / 20s (heavy) accommodate initial model load + inference
# - Socket timeout margin: +5.0s ensures healthy TCP layer interaction

# Timeout values for Ollama inference (in seconds)
# Previous: 2.5s → 10s. Now: 10s → 15s (fast), 8s → 20s (heavy) for cold start safety
OLLAMA_FAST_TIMEOUT_SECONDS=15.0
OLLAMA_HEAVY_TIMEOUT_SECONDS=20.0

# Ollama server endpoint (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Default model for governance (fastest for minimum latency)
# ✅ Explicitly set to fastest model: qwen3.5:0.8b (0.8 billion parameters)
OLLAMA_MODEL_FAST=qwen3.5:0.8b

# Optional: Heavy model for complex risk analysis
OLLAMA_MODEL_HEAVY=qwen3.5:4b

# Keep models loaded in memory (prevents cold-start reload penalty)
# Format: "1h" = 1 hour, "30m" = 30 minutes (adjust based on trading hours)
OLLAMA_KEEP_ALIVE=1h

# ============================================================================
# MT5 CONNECTION
# ============================================================================
# MetaTrader 5 credentials (if not using config.json)
# MT5_ACCOUNT=
# MT5_PASSWORD=
# MT5_SERVER=

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_FORMAT=detailed
